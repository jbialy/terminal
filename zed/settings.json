    "codex-acp": {
      "type": "registry",
    },
    "cursor": {
      "type": "registry",
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "agent_ui_font_size": 16,
  "agent_buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Ayu Dark",
  },
