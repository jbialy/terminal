syntax on

set number
set relativenumber
set wrap
set cursorline
set scrolloff=8

set tabstop=4
set shiftwidth=4
set expandtab
set autoindent

set ignorecase
set smartcase
set incsearch
set hlsearch

set backspace=indent,eol,start
set clipboard=unnamed
set showmatch
set wildmenu

set laststatus=2
set showcmd
set ruler

set smartindent
set copyindent

nnoremap // :noh<CR>
